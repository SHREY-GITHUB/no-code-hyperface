# ─────────────────────────────────────────────────────────────────────────────
# Hyperface Studio — Server Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local example shown below)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hyperface_studio"

# ── API Security ──────────────────────────────────────────────────────────────
# All /api/* requests must include this header: x-api-key: <value>
# Generate a strong random key: openssl rand -hex 32
API_KEY="replace-me-with-a-strong-random-key"

# ── Mixpanel ──────────────────────────────────────────────────────────────────
# Server-side Mixpanel project token (from mixpanel.com → Project Settings)
# Leave blank to disable server-side tracking (events will be silently dropped)
MIXPANEL_TOKEN=""

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production frontend URL — add here to allow cross-origin requests
# In dev, localhost:5173 and localhost:4173 are always allowed
FRONTEND_URL=""
