# ─────────────────────────────────────────────────────────────────────────────
# Hyperface Studio — Frontend Environment Variables
# Copy to .env.local and fill in the values.
# In Vercel, set these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# URL of your deployed Express backend (no trailing slash)
# Example: https://hyperface-api.up.railway.app
VITE_API_BASE=http://localhost:3001/api

# Must match the API_KEY set on the server
VITE_API_KEY=replace-me-with-same-key-as-server

# Optional: Mixpanel browser token (leave blank to disable)
VITE_MIXPANEL_TOKEN=
